---
import { SLOTS } from '../lib/slots';
import ShortcutsHelp from './ShortcutsHelp.astro';
import ThemePicker from './ThemePicker.astro';

interface Props {
  /** Reserve the slot the page's island fills: its header actions (the converter's Copy URL button). */
  actions?: boolean;
  /**
   * Show the keyboard shortcuts map: on the converter's page, whose shortcuts they are, and in the
   * gallery's sample of it (Sean, 2026-10-15: on About they mean nothing).
   */
  shortcuts?: boolean;
}

const { actions = false, shortcuts = false } = Astro.props;

/*
 * The header's controls, in one place so every page shows the same ones in the same order. The
 * actions slot is the size of the icon buttons beside it (a 44 px button inside 2 px, like the
 * shells' edges), so the button the island draws into it lines up and nothing shifts.
 *
 * The row is a toolbar and the page's first plane (ADR 0014): one Tab stop, the arrows moving
 * along its [data-tool] controls and up and down the page, driven by the inline script in
 * layouts/Base.astro.
 *
 * Spaced as the converter's toolbar is (docs/DESIGN-SYSTEM.md, "Icon buttons"; Sean, 2026-10-08):
 * 4 px between buttons, their 48 px places touching, each 44 px button 2 px inside its
 * place, and 8 px from the last button to the theme menu's trigger (gap-1.5 and that 2 px), as
 * the toolbar's dividers sit 8 px from its buttons.
 *
 * The header keeps one line (Sean, 2026-10-17; docs/UX-SPEC.md §1). Where the page's header (an
 * @container) is narrower than sm, 384 px, too narrow for every theme's name, art, Copy URL, and
 * the theme menu together (Hardhat's wide name needs the most, 347 px), the icons hide, Copy URL
 * among them, as the shortcuts button hides under xl: a nice-to-have gives way, and a phone shares
 * its address from the browser. The name and the theme menu alone fit every theme down to xs,
 * 320 px (Hardhat needs 297); narrower still, the theme menu takes a line of its own under the
 * name, flush left. Wider than sm, the menus sit on the right, the icons before the theme menu.
 */
---

<div
  role="toolbar"
  aria-label="Site"
  class="ml-auto flex items-start gap-1.5 @max-xs:ml-0 @max-xs:basis-full"
  data-header-menus
  data-plane="header"
>
  <div class="flex items-start @max-sm:hidden">
    {shortcuts && <ShortcutsHelp />}
    {actions && <div id={SLOTS.headerActions} class="size-12 p-0.5" />}
  </div>
  <div class="flex items-start">
    <ThemePicker />
  </div>
</div>
