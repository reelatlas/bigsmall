---
import HeaderMenus from './HeaderMenus.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  /** Reserve the slot the page's island fills with its header actions (HeaderMenus). */
  actions?: boolean;
  /** Show the keyboard shortcuts map, where its shortcuts work (HeaderMenus). */
  shortcuts?: boolean;
  /** The wordmark waits for the page to play it, as on the wordmark lab (Wordmark). */
  manual?: boolean;
  /** The page's content column, which the header is as wide as (CONTENT_COLUMN; the converter's grid places it). */
  class?: string;
}

const { actions = false, shortcuts = false, manual = false, class: className } = Astro.props;

/*
 * The header every page shares: the wordmark with its theme art, then the header menus. The
 * header is an @container: under its sm size the icons hide so the theme menu keeps the name's
 * line, and under xs the theme menu takes a line of its own, 20 px under the name (HeaderMenus,
 * docs/UX-SPEC.md §1). As wide as the page's column, which the page gives (`class`): the
 * column is one and centered on every page (CONTENT_COLUMN, docs/DESIGN-SYSTEM.md, "A column
 * beside the rows"), the converter page's the first track of its grid, which a side panel joins.
 */
---

<header
  class:list={['@container flex flex-wrap items-center justify-between gap-x-4 gap-y-5', className]}
>
  <Wordmark manual={manual} />
  <HeaderMenus actions={actions} shortcuts={shortcuts} />
</header>
