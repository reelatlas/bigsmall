---
import { SHELL, SHELL_GHOST, SHELL_PANEL } from '../lib/recipes';
import { SHORTCUTS } from '../lib/shortcuts';
import { Button } from './Button';
import { KeyboardIcon } from './icons';
import { Keycap } from './Keycap';

const panelId = 'shortcuts-panel';
const titleId = 'shortcuts-title';

/*
 * The keyboard shortcuts map. At rest it is the same ghost icon button as undo, redo, and clear
 * all; open, its shell (lib/recipes.ts) takes the fluid-shell edge, surface, and shadow and grows
 * left and down from the icon over the page, the way the theme menu grows out of its trigger. A
 * mouse resting on it opens it for a look, a click pins it open, and Escape, a click elsewhere,
 * or focus leaving closes it, so the content can be hovered, dismissed, and stays put until then
 * (WCAG 1.4.13). The inline script in layouts/Base.astro drives it, so it adds no bundle; Button
 * and the icon are TSX components rendered to static HTML. Hidden on touch-first devices, which
 * have no keyboard to use, and below the sm breakpoint, where a panel growing left from beside the
 * theme menu would run off the screen. The list itself lives in src/lib/shortcuts.ts.
 */
---

<div
  class="group relative hidden size-12 sm:block pointer-coarse:hidden"
  data-shell
  data-shell-hover
>
  <div class:list={['absolute top-0 right-0 rounded-md', SHELL, SHELL_GHOST]}>
    <div class="flex items-center">
      <h2
        id={titleId}
        class="hidden flex-1 px-3 text-sm font-medium text-ink group-data-open:block"
      >
        Keyboard shortcuts
      </h2>
      <Button
        variant="ghost"
        square
        data-shell-toggle
        aria-expanded="false"
        aria-controls={panelId}
        aria-label="Keyboard shortcuts"
        className="group-data-open:focus-ring-inset"
      >
        <KeyboardIcon />
      </Button>
    </div>
    <div
      id={panelId}
      role="group"
      aria-labelledby={titleId}
      class:list={[SHELL_PANEL, 'w-72 px-3 py-2']}
    >
      <dl>
        {SHORTCUTS.map((shortcut) => (
          <div class="flex min-h-8 items-center justify-between gap-3">
            <dt class="text-sm text-ink">{shortcut.action}</dt>
            <dd class="flex shrink-0 items-center gap-1.5 text-xs text-ink-muted">
              {shortcut.keys.map((combo, alternative) => (
                <>
                  {alternative > 0 && <span>or</span>}
                  <span class="inline-flex items-center gap-1">
                    {combo.map((key) => (
                      <Keycap label={key} />
                    ))}
                  </span>
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</div>
