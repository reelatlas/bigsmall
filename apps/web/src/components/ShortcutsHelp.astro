---
import { PANEL_TITLE, SHELL, SHELL_PANEL } from '../lib/recipes';
import { SHORTCUTS } from '../lib/shortcuts';
import { Button } from './Button';
import { KeyboardIcon } from './icons';
import { Keycap } from './Keycap';

/**
 * Its resting style: a borderless icon button that becomes a card when open, clipped to its
 * corners only then, so the icon's focus ring shows at rest as Copy URL's does. No transition:
 * its panel appears and vanishes at once, so an edge that faded would be left behind as a green
 * square around the icon (docs/LEARNINGS.md, "A focus-within edge lingers").
 */
const GHOST = 'border-transparent group-data-open:overflow-hidden group-data-open:bg-surface';

/**
 * Open, the icon is switched on, the accent's soft fill, as the toolbar's buttons are while their
 * panels are open (Sean, 2026-10-15), the open shell's accent edge showing where focus is.
 */
const TOGGLE_OPEN =
  'group-data-open:bg-accent-soft group-data-open:text-ink group-data-open:outline-none group-data-open:hover:bg-accent-soft';

const panelId = 'shortcuts-panel';
const titleId = 'shortcuts-title';

/*
 * The keyboard shortcuts map. At rest it is the same ghost icon button as undo, redo, and clear
 * all; open, its shell (lib/recipes.ts) takes the fluid-shell edge, surface, and shadow and grows
 * left and down from the icon over the page, the way the theme menu grows out of its trigger.
 * While it is open, the shell's accent edge is the icon's focus indicator, as a field's is, so the
 * icon, switched on, draws no ring of its own. A click opens it, and a second click, Escape, a
 * click elsewhere, or focus leaving closes it (Sean, 2026-10-15: it opened on hover and on focus
 * until then). The inline script in layouts/Base.astro drives it, so it adds no bundle; Button
 * and the icon are TSX components rendered to static HTML. Hidden on touch-first devices, which
 * have no keyboard to use, and below the sm breakpoint, where a panel growing left from beside the
 * theme menu would run off the screen. The list itself lives in src/lib/shortcuts.ts.
 */
---

<div class="group relative hidden size-12 sm:block pointer-coarse:hidden" data-shell>
  <div class:list={['absolute top-0 right-0 rounded-md', SHELL, GHOST]}>
    <div class="flex items-center">
      <h2 id={titleId} class:list={['hidden flex-1 px-3 group-data-open:block', PANEL_TITLE]}>
        Keyboard shortcuts
      </h2>
      <Button
        variant="ghost"
        square
        data-shell-toggle
        data-tool="shortcuts"
        aria-expanded="false"
        aria-controls={panelId}
        aria-label="Keyboard shortcuts"
        className={TOGGLE_OPEN}
      >
        <KeyboardIcon />
      </Button>
    </div>
    <div
      id={panelId}
      role="group"
      aria-labelledby={titleId}
      class:list={[SHELL_PANEL, 'w-72 px-3 py-2']}
    >
      <dl>
        {SHORTCUTS.map((shortcut) => (
          <div
            class:list={[
              'flex min-h-8 items-center justify-between gap-3',
              shortcut.startsGroup && 'mt-1 border-t border-line pt-1',
            ]}
            data-starts-group={shortcut.startsGroup || undefined}
          >
            <dt class="text-sm text-ink">{shortcut.action}</dt>
            <dd class="flex shrink-0 items-center gap-1.5 text-xs text-ink-muted">
              {shortcut.keys.map((combo, alternative) => (
                <>
                  {alternative > 0 && <span>or</span>}
                  <span class="inline-flex items-center gap-1">
                    {combo.map((key) => (
                      <Keycap label={key} />
                    ))}
                  </span>
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</div>
