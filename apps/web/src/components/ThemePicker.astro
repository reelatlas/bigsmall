---
import { SHELL, SHELL_BORDERED } from '../lib/shell';
import { DEFAULT_LIGHT, THEMES } from '../lib/themes';
import { ChevronDownIcon } from './icons';

interface Props {
  id?: string;
}

const { id = 'theme' } = Astro.props;
const menuId = `${id}-menu`;
const defaultName = THEMES.find((t) => t.id === DEFAULT_LIGHT)?.name;
---

<!--
  The theme menu: a fluid shell (lib/shell.ts) whose trigger and options are one shape, growing
  over the page when open. No bundle: the inline script in layouts/Base.astro opens and closes it
  (data-shell), applies and saves the chosen radio, and fills in the current name. The options are
  native radios, so arrow keys, Space, and screen readers work without any script. The shell's
  edge turns accent while anything inside has focus, which is the trigger's focus indicator. Option
  rows use rounded-nested-md, the md corner minus the border and gutter, so the curves nest. Below
  sm the word "Theme" is only for screen readers and the menu narrows, so the header keeps one line
  on a 360 px phone beside the copy-link button.
-->
<div class="group relative h-12 w-32 sm:w-44" data-shell>
  <div class={`absolute inset-x-0 top-0 rounded-md ${SHELL} ${SHELL_BORDERED}`}>
    <button
      type="button"
      data-shell-toggle
      aria-expanded="false"
      aria-controls={menuId}
      class="flex h-11 w-full items-center justify-between gap-2 px-3 text-sm text-ink transition-colors outline-none hover:bg-surface-raised"
    >
      <span class="text-ink-muted max-sm:sr-only">Theme</span>
      <span class="flex items-center gap-1">
        <span data-theme-name>{defaultName}</span>
        <ChevronDownIcon
          width="16"
          height="16"
          className="text-ink-muted transition-transform group-data-open:rotate-180"
        />
      </span>
    </button>
    <fieldset id={menuId} class="hidden border-t border-line p-1 group-data-open:block">
      <legend class="sr-only">Theme</legend>
      {THEMES.map((t) => (
        <label class="flex min-h-11 cursor-pointer items-center rounded-nested-md px-2 text-sm text-ink focus-ring-within-inset hover:bg-surface-raised has-checked:bg-accent-soft">
          <input
            type="radio"
            name={`${id}-option`}
            value={t.id}
            data-theme-option
            data-shell-initial
            class="sr-only"
            checked={t.id === DEFAULT_LIGHT}
          />
          {t.name}
        </label>
      ))}
    </fieldset>
  </div>
</div>
