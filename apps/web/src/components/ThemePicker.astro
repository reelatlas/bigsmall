---
import {
  MENU_CHEVRON,
  MENU_OPTION,
  MENU_ROOT,
  MENU_SHELL,
  MENU_SIZER,
  MENU_SIZER_LABEL,
  MENU_TRIGGER,
  SHELL_PANEL,
} from '../lib/recipes';
import { DEFAULT_LIGHT, THEMES } from '../lib/themes';
import { ChevronDownIcon } from './icons';

const menuId = 'theme-menu';
const defaultName = THEMES.find((t) => t.id === DEFAULT_LIGHT)?.name;

/*
 * The theme menu: at rest a ghost, its label, name, and chevron with no edge or fill, as the icon
 * buttons beside it are; open, a card around the trigger and its options, the same width
 * (lib/recipes.ts). No bundle: the inline script in layouts/Base.astro opens and closes it
 * (data-shell), applies and saves the chosen radio, and fills in the current name. The options are
 * native radios, so arrow keys, Space, and screen readers work without any script. The trigger
 * covers the whole menu and never changes size; option rows use rounded-nested-md, the md corner
 * minus the card's border and gutter, so the curves nest. The menu is as wide as its widest label,
 * so nothing beside it moves while the arrow keys preview themes, and the card is the same width:
 * the sizer below stacks every name in one grid cell, unseen, in the theme's own font. At rest
 * the trigger shows the theme's name alone, the word "Theme" only for screen readers; open, it
 * reads "Theme" instead, muted, over the list, whose fill marks the theme, as the category menu
 * reads "Category" (Sean, 2026-10-17: one behavior for both menus; a wide header showed "Theme"
 * and the name until then).
 */
---

<div class={MENU_ROOT} data-shell>
  <span aria-hidden="true" class={MENU_SIZER}>
    {THEMES.map((t) => (
      <span class={MENU_SIZER_LABEL}>
        {t.name}
        <span class="size-4" />
      </span>
    ))}
  </span>
  <div class={MENU_SHELL}>
    <button
      type="button"
      data-shell-toggle
      data-tool="theme"
      aria-expanded="false"
      aria-controls={menuId}
      class={MENU_TRIGGER}
    >
      <span class="text-ink-muted sr-only group-data-open:not-sr-only">Theme</span>
      <span data-theme-name class="group-data-open:hidden">
        {defaultName}
      </span>
      <ChevronDownIcon width="16" height="16" className={MENU_CHEVRON} />
    </button>
    <fieldset id={menuId} class:list={[SHELL_PANEL, 'p-1']}>
      <legend class="sr-only">Theme</legend>
      {THEMES.map((t) => (
        <label class={MENU_OPTION}>
          <input
            type="radio"
            name="theme-option"
            value={t.id}
            data-theme-option
            data-shell-initial
            class="sr-only"
            checked={t.id === DEFAULT_LIGHT}
          />
          {t.name}
        </label>
      ))}
    </fieldset>
  </div>
</div>
