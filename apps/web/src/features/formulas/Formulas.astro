---
import { ChevronDownIcon } from '../../components/icons';
import { cx, DISCLOSURE } from '../../lib/recipes';
import { FORMULAS_HEADING, formulaGroups, SIGNIFICANT } from './formulas';
import { FormulasTools } from './FormulasTools';

/*
 * Every formula, under its tab on the About page (docs/UX-SPEC.md §1, "About"; Sean, 2026-10-15,
 * 16, and 18, the tab its title): each category folded, its units inside, each with what one of it is in the
 * category's base unit, exact or measured, and the standard it was checked against. Drawn when the
 * site is built from core's own units (formulas.ts), so a check reads what the converter runs;
 * the categories open with their own summaries, and FormulasTools adds Show all and Copy all, in
 * a bar that stays at the window's top while the list scrolls past, and an open category's name
 * stays under it while its units do. In the page's column, its lines, tools, and rows on the
 * column's left edge, to be scanned (the lines centered under a heading until 2026-10-18).
 */
const groups = formulaGroups();
// Units alone: Cooking lists ingredients, which are not units.
const units = groups.reduce(
  (count, group) => count + (group.category.over ? 0 : group.lines.length),
  0,
);
const listId = 'formula-list';

/**
 * A unit's row: its name, then its formula and tag, then the source. Where the list has the room
 * (its own width, 512 px), the name takes a column and the rest line up beside it; narrower, each
 * takes a line, so every row reads the same way.
 */
const ROW = 'grid gap-x-3 gap-y-0.5 py-1.5 @lg:grid-cols-[minmax(0,--spacing(48))_minmax(0,1fr)]';

/**
 * Exact by definition, or measured: a small tag after the formula, on the shape token's smallest
 * corner, the keycap's, which each theme sets (Sean, 2026-10-18; a pill, `rounded-full`, outside
 * the tokens, until then; the token guard rejects it now).
 */
const TAG = 'rounded-sm px-2 text-xs font-medium';
const EXACT = cx(TAG, 'bg-accent-soft text-ink');
const MEASURED = cx(TAG, 'bg-surface-raised text-ink-muted');

/** A number in the line of counts, in the ink beside its muted words, so the values stand out. */
const STAT = 'font-numeric text-ink';

/**
 * A category's name, which stays under the bar while its units scroll past and gives way to the
 * next one's (Sean, 2026-10-16): sticky, at the bar's height, which FormulasTools measures and
 * sets. Square and opaque, as a bar over scrolling content must be (docs/LEARNINGS.md, "A sticky
 * bar with rounded corners shows what scrolls under it"), its focus ring inside its edge, where
 * the bar over it cannot cover it.
 */
const SUMMARY = cx(
  DISCLOSURE,
  'sticky list-none bg-canvas focus-ring-inset [&::-webkit-details-marker]:hidden',
);
---

<div>
  <p class="text-sm text-ink-muted">
    Each conversion in its category’s base unit and the source it was checked against.
  </p>
  <p class="mt-1 text-sm text-ink-muted">
    <span class={STAT}>{units}</span> units · <span class={STAT}>{groups.length}</span> categories ·{' '}
    <span class={STAT}>{SIGNIFICANT}</span> digits in each factor
  </p>
  <FormulasTools client:idle listId={listId} heading={FORMULAS_HEADING} />
  <div id={listId} class="@container">
    {groups.map(({ category, lines, summary, plain }) => (
      <details class="group border-t border-line first:border-t-0 last:border-b" data-plain={plain}>
        <summary class={SUMMARY}>
          <ChevronDownIcon
            width="16"
            height="16"
            className="shrink-0 -rotate-90 text-ink-muted transition-transform group-open:rotate-0"
          />
          <span class="font-medium">{category.name}</span>
          <span class="text-sm text-ink-muted">{summary}</span>
        </summary>
        <ol class="mb-4 pl-8">
          {lines.map((line) => (
            <li class={ROW} data-plain={line.plain}>
              <span>{line.name}</span>
              <span class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                <span class="font-numeric wrap-anywhere">{line.formula}</span>
                <span class={line.exact ? EXACT : MEASURED}>
                  {line.exact ? 'exact' : 'measured'}
                </span>
              </span>
              <p class="text-xs text-ink-muted wrap-anywhere @lg:col-start-2">{line.source}</p>
            </li>
          ))}
        </ol>
      </details>
    ))}
  </div>
</div>
