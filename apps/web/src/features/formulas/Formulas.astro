---
import { ChevronDownIcon } from '../../components/icons';
import { FORMULAS_HEADING, formulaGroups } from './formulas';
import { FormulasTools } from './FormulasTools';

/*
 * Every formula, on the About page under the sketchbook (docs/UX-SPEC.md §1, "About"; Sean,
 * 2026-10-15 and 16): each category folded, its units inside, each with what one of it is in the
 * category's base unit, exact or measured, and the standard it was checked against. Drawn when the
 * site is built from core's own units (formulas.ts), so a check reads what the converter runs;
 * the categories open with their own summaries, and FormulasTools adds Show all and Copy all.
 */
const groups = formulaGroups();
const units = groups.reduce((count, group) => count + group.lines.length, 0);
const listId = 'formula-list';

/**
 * A unit's row: its name, then its formula and tag, then the source. Where the list has the room
 * (its own width, 512 px), the name takes a column and the rest line up beside it; narrower, each
 * takes a line, so every row reads the same way.
 */
const ROW = 'grid gap-x-3 gap-y-0.5 py-1.5 @lg:grid-cols-[minmax(0,--spacing(48))_minmax(0,1fr)]';

/** Exact by definition, or measured: a small tag after the formula. */
const TAG = 'rounded-full px-2 text-xs font-medium';
const EXACT = `${TAG} bg-accent-soft text-ink`;
const MEASURED = `${TAG} bg-surface-raised text-ink-muted`;
---

<section class="mt-16 sm:mt-24" aria-labelledby="formulas">
  <h2 id="formulas" class="font-display text-xl font-semibold">
    Every formula
  </h2>
  <p class="mt-2 max-w-prose text-sm text-ink-muted">
    Every conversion bigsmall makes, unit by unit, each in its category's base unit, with the
    standard it was checked against: {units} units in {groups.length} categories, each factor to 16
    significant digits.
  </p>
  <FormulasTools client:idle listId={listId} heading={FORMULAS_HEADING} />
  <div id={listId} class="@container mt-4">
    {groups.map(({ category, base, lines, plain }) => (
      <details class="group border-t border-line last:border-b" data-plain={plain}>
        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-3 rounded-md px-1 [&::-webkit-details-marker]:hidden">
          <ChevronDownIcon
            width="16"
            height="16"
            className="shrink-0 -rotate-90 text-ink-muted transition-transform group-open:rotate-0"
          />
          <span class="font-medium">{category.name}</span>
          <span class="text-sm text-ink-muted">
            {lines.length} units, in {base.plural}
          </span>
        </summary>
        <ol class="mb-4 pl-8">
          {lines.map((line) => (
            <li class={ROW} data-plain={line.plain}>
              <span>{line.name}</span>
              <span class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                <span class="font-numeric [overflow-wrap:anywhere]">{line.formula}</span>
                <span class={line.exact ? EXACT : MEASURED}>
                  {line.exact ? 'exact' : 'measured'}
                </span>
              </span>
              <p class="text-xs text-ink-muted [overflow-wrap:anywhere] @lg:col-start-2">
                {line.source}
              </p>
            </li>
          ))}
        </ol>
      </details>
    ))}
  </div>
</section>
