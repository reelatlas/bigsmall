---
/*
 * The sketchbook's art, set on the page once: each file in src/assets/sketchbook/ as a symbol,
 * which a tile shows by its id (motion.ts, sketchHref). The files keep colors of their own, like
 * the brand assets (docs/DESIGN-SYSTEM.md, "The sketchbook"). Hidden from screen readers: each
 * tile is named for its sketch.
 */
const files = import.meta.glob<string>('../../assets/sketchbook/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const symbols = Object.entries(files)
  .map(([path, svg]) => {
    const id = path.slice(path.lastIndexOf('/') + 1, -'.svg'.length);
    const art = svg.replace(/^\s*<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
    return `<symbol id="sketch-${id}" viewBox="0 0 32 32">${art}</symbol>`;
  })
  .join('');
---

<svg
  aria-hidden="true"
  focusable="false"
  class="absolute size-0 overflow-hidden"

  set:html={symbols}
/>
