---
import '../styles/global.css';
import { APPLE_PLATFORM } from '../lib/platform';
import { DEFAULT_DARK, DEFAULT_LIGHT, THEMES, THEME_STORAGE_KEY } from '../lib/themes';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A unit converter that gets out of your way.' } = Astro.props;
const themeIds = THEMES.map((t) => t.id);
const themeNames = Object.fromEntries(THEMES.map((t) => [t.id, t.name]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script
      define:vars={{
        ids: themeIds,
        names: themeNames,
        key: THEME_STORAGE_KEY,
        light: DEFAULT_LIGHT,
        dark: DEFAULT_DARK,
        applePlatform: APPLE_PLATFORM.source,
        applePlatformFlags: APPLE_PLATFORM.flags,
      }}
    >
      // Runs inline before first paint: applies the saved theme (no flash) and drives the header
      // menus (theme, keyboard shortcuts) by delegation, so they never wait for a JS bundle. Values
      // come from src/lib/themes.ts via define:vars, so there is one source of truth.
      const apply = (id) => {
        document.documentElement.dataset.theme = id;
        for (const option of document.querySelectorAll('[data-theme-option]')) {
          option.checked = option.value === id;
        }
        for (const name of document.querySelectorAll('[data-theme-name]')) {
          name.textContent = names[id] || id;
        }
      };
      const readSaved = () => {
        try {
          return localStorage.getItem(key);
        } catch {
          return null;
        }
      };
      const saved = readSaved();
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      apply(ids.includes(saved) ? saved : prefersDark ? dark : light);
      document.addEventListener('DOMContentLoaded', () =>
        apply(document.documentElement.dataset.theme),
      );

      // Shortcuts name the platform's modifier key: Ctrl, or ⌘ on Apple devices (src/lib/platform.ts).
      const apple = new RegExp(applePlatform, applePlatformFlags).test(
        navigator.userAgentData?.platform ?? navigator.platform ?? '',
      );
      if (apple) {
        document.addEventListener('DOMContentLoaded', () => {
          for (const label of document.querySelectorAll('[data-mod-key]')) label.textContent = '⌘';
        });
      }

      // Header menus (the theme menu, the shortcuts map) are fluid shells driven from here, so
      // they work before any bundle loads and add none. A [data-shell] holds a
      // [data-shell-toggle]; [data-open] shows its panel, and [data-pinned] marks one a click
      // opened, as opposed to a mouse resting on it.
      const toggleOf = (shell) => shell.querySelector('[data-shell-toggle]');
      const setOpen = (shell, open, pinned) => {
        shell.toggleAttribute('data-open', open);
        shell.toggleAttribute('data-pinned', open && pinned);
        toggleOf(shell)?.setAttribute('aria-expanded', String(open));
      };
      const closeAll = (except) => {
        for (const shell of document.querySelectorAll('[data-shell]')) {
          if (shell !== except) setOpen(shell, false, false);
        }
      };
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const toggle = target?.closest('[data-shell-toggle]');
        if (toggle) {
          const shell = toggle.closest('[data-shell]');
          // A click pins a shell that hovering opened; a click on a pinned shell closes it.
          const open = !shell.hasAttribute('data-pinned');
          closeAll(shell);
          setOpen(shell, open, true);
          if (open) shell.querySelector('[data-shell-initial]:checked')?.focus();
          return;
        }
        if (!target?.closest('[data-shell]')) closeAll();
      });

      // A [data-shell-hover] also opens while a mouse rests on it and closes shortly after the
      // mouse leaves, unless a click pinned it: the panel can be hovered, dismissed with Escape,
      // and stays until then (WCAG 1.4.13). Touch never peeks; a tap is a click.
      const peekTimers = new WeakMap();
      const peek = (event, open) => {
        if (event.pointerType !== 'mouse' || !(event.target instanceof Element)) return;
        const shell = event.target.closest('[data-shell-hover]');
        if (!shell) return;
        const related =
          event.relatedTarget instanceof Element
            ? event.relatedTarget.closest('[data-shell-hover]')
            : null;
        if (related === shell) return;
        clearTimeout(peekTimers.get(shell));
        const timer = setTimeout(
          () => {
            if (open && !shell.hasAttribute('data-open')) {
              closeAll(shell);
              setOpen(shell, true, false);
            } else if (!open && !shell.hasAttribute('data-pinned')) {
              setOpen(shell, false, false);
            }
          },
          open ? 120 : 200,
        );
        peekTimers.set(shell, timer);
      };
      document.addEventListener('pointerover', (event) => peek(event, true));
      document.addEventListener('pointerout', (event) => peek(event, false));

      document.addEventListener('change', (event) => {
        const option = event.target;
        if (!(option instanceof HTMLInputElement) || !option.hasAttribute('data-theme-option'))
          return;
        if (!ids.includes(option.value)) return;
        apply(option.value);
        try {
          localStorage.setItem(key, option.value);
        } catch {
          // Storage blocked (private mode): the choice lasts for this page only.
        }
        const shell = option.closest('[data-shell]');
        if (shell) {
          setOpen(shell, false, false);
          toggleOf(shell)?.focus();
        }
      });
      // Escape closes any open shell, hovered or pinned; focus returns to its toggle if it was inside.
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        for (const shell of document.querySelectorAll('[data-shell][data-open]')) {
          const focusWasInside = shell.contains(document.activeElement);
          setOpen(shell, false, false);
          if (focusWasInside) toggleOf(shell)?.focus();
        }
      });
    </script>
  </head>
  <body class="min-h-dvh bg-canvas font-body text-ink antialiased">
    <slot />
  </body>
</html>
