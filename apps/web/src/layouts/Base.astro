---
import '../styles/global.css';
import { DEFAULT_DARK, DEFAULT_LIGHT, THEMES, THEME_STORAGE_KEY } from '../lib/themes';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A unit converter that gets out of your way.' } = Astro.props;
const themeIds = THEMES.map((t) => t.id);
const themeNames = Object.fromEntries(THEMES.map((t) => [t.id, t.name]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script
      define:vars={{
        ids: themeIds,
        names: themeNames,
        key: THEME_STORAGE_KEY,
        light: DEFAULT_LIGHT,
        dark: DEFAULT_DARK,
      }}
    >
      // Runs inline before first paint: applies the saved theme (no flash) and drives every theme
      // picker by delegation, so switching never waits for a JS bundle. Values come from
      // src/lib/themes.ts via define:vars, so there is one source of truth.
      const apply = (id) => {
        document.documentElement.dataset.theme = id;
        for (const option of document.querySelectorAll('[data-theme-option]')) {
          option.checked = option.value === id;
        }
        for (const name of document.querySelectorAll('[data-theme-name]')) {
          name.textContent = names[id] || id;
        }
      };
      const readSaved = () => {
        try {
          return localStorage.getItem(key);
        } catch {
          return null;
        }
      };
      const saved = readSaved();
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      apply(ids.includes(saved) ? saved : prefersDark ? dark : light);
      document.addEventListener('DOMContentLoaded', () =>
        apply(document.documentElement.dataset.theme),
      );

      const setOpen = (shell, open) => {
        shell.toggleAttribute('data-open', open);
        const toggle = shell.querySelector('[data-theme-toggle]');
        if (toggle) toggle.setAttribute('aria-expanded', String(open));
      };
      const closeAll = () => {
        for (const shell of document.querySelectorAll('[data-theme-shell]')) setOpen(shell, false);
      };
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const toggle = target?.closest('[data-theme-toggle]');
        if (toggle) {
          const shell = toggle.closest('[data-theme-shell]');
          const open = !shell.hasAttribute('data-open');
          closeAll();
          setOpen(shell, open);
          if (open) shell.querySelector('[data-theme-option]:checked')?.focus();
          return;
        }
        if (!target?.closest('[data-theme-shell]')) closeAll();
      });
      document.addEventListener('change', (event) => {
        const option = event.target;
        if (!(option instanceof HTMLInputElement) || !option.hasAttribute('data-theme-option'))
          return;
        if (!ids.includes(option.value)) return;
        apply(option.value);
        try {
          localStorage.setItem(key, option.value);
        } catch {
          // Storage blocked (private mode): the choice lasts for this page only.
        }
        const shell = option.closest('[data-theme-shell]');
        if (shell) {
          setOpen(shell, false);
          shell.querySelector('[data-theme-toggle]')?.focus();
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !(event.target instanceof Element)) return;
        const shell = event.target.closest('[data-theme-shell]');
        if (shell && shell.hasAttribute('data-open')) {
          setOpen(shell, false);
          shell.querySelector('[data-theme-toggle]')?.focus();
        }
      });
    </script>
  </head>
  <body class="min-h-dvh bg-canvas font-body text-ink antialiased">
    <slot />
  </body>
</html>
