---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import { PLANE_EVENT } from '../lib/planes';
import { APPLE_PLATFORM } from '../lib/platform';
import { SITE, UMAMI_WEBSITE_ID } from '../lib/site';
import { STARTS_TYPING } from '../lib/typing';
import { DEFAULT_DARK, DEFAULT_LIGHT, THEMES, THEME_STORAGE_KEY } from '../lib/themes';

interface Props {
  title: string;
  description?: string;
  /** Ask search engines not to index the page (the /dev pages, the not-found page); it then names no canonical address. */
  noindex?: boolean;
}

const { title, description = SITE.description, noindex = false } = Astro.props;
// Absolute addresses on the main domain (astro.config.mjs `site`), as link previews require.
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(SITE.image, Astro.site);
const themeIds = THEMES.map((t) => t.id);
const themeNames = Object.fromEntries(THEMES.map((t) => [t.id, t.name]));
/*
 * Counting (ADR 0019): Umami's tracker, served from the site's own address by vercel.json's
 * rewrites, on the production deployment alone, so local builds, the browser tests, and preview
 * deployments load nothing. No query string or hash is sent, so the URL's conversion stays out and
 * the page counts once however often the URL is rewritten.
 */
const analytics = UMAMI_WEBSITE_ID !== '' && process.env['VERCEL_ENV'] === 'production';
/*
 * Structured data on the converter's page, the site's home (docs/SEO.md): its name in results
 * (WebSite), who makes it, with the logo (Organization), and what it is (WebApplication). Written
 * as JSON with "<" escaped, so nothing in it can close the script.
 */
const homeUrl = new URL('/', Astro.site).href;
const structured =
  !noindex && Astro.url.pathname === '/'
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': `${homeUrl}#website`,
            name: SITE.name,
            url: homeUrl,
            description,
            inLanguage: 'en',
          },
          {
            '@type': 'Organization',
            '@id': `${homeUrl}#organization`,
            name: SITE.name,
            url: homeUrl,
            logo: new URL(SITE.logo, Astro.site).href,
          },
          {
            '@type': 'WebApplication',
            name: SITE.name,
            url: homeUrl,
            applicationCategory: 'UtilitiesApplication',
            operatingSystem: 'Any',
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
          },
        ],
      }).replace(/</g, '\\u003c')
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {structured && <script is:inline type="application/ld+json" set:html={structured} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {analytics && (
      <script
        is:inline
        defer
        src="/ux/s.js"
        data-website-id={UMAMI_WEBSITE_ID}
        data-host-url={new URL('/ux', Astro.site).href}
        data-domains={Astro.site?.hostname}
        data-exclude-search="true"
        data-exclude-hash="true"
      />
    )}
    <script
      define:vars={{
        ids: themeIds,
        names: themeNames,
        key: THEME_STORAGE_KEY,
        light: DEFAULT_LIGHT,
        dark: DEFAULT_DARK,
        applePlatform: APPLE_PLATFORM.source,
        applePlatformFlags: APPLE_PLATFORM.flags,
        planeEvent: PLANE_EVENT,
        startsTyping: STARTS_TYPING.source,
        startsTypingFlags: STARTS_TYPING.flags,
      }}
    >
      // Runs inline before first paint: applies the saved theme (no flash) and drives the header
      // menus (theme, keyboard shortcuts) and the page's toolbars and planes by delegation, so
      // they never wait for a JS bundle. Values come from src/lib via define:vars, so there is one
      // source of truth.
      const apply = (id) => {
        document.documentElement.dataset.theme = id;
        for (const option of document.querySelectorAll('[data-theme-option]')) {
          option.checked = option.value === id;
        }
        for (const label of document.querySelectorAll('[data-theme-name]')) {
          label.textContent = names[id] || id;
        }
      };
      const readSaved = (name) => {
        try {
          return localStorage.getItem(name);
        } catch {
          return null;
        }
      };
      const saved = readSaved(key);
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      apply(ids.includes(saved) ? saved : prefersDark ? dark : light);
      document.addEventListener('DOMContentLoaded', () =>
        apply(document.documentElement.dataset.theme),
      );

      // Shortcuts name the platform's keys: Ctrl, or ⌘ on Apple devices, and Alt, or ⌥ there
      // (src/lib/platform.ts).
      const apple = new RegExp(applePlatform, applePlatformFlags).test(
        navigator.userAgentData?.platform ?? navigator.platform ?? '',
      );
      if (apple) {
        document.addEventListener('DOMContentLoaded', () => {
          for (const label of document.querySelectorAll('[data-mod-key]')) label.textContent = '⌘';
          for (const label of document.querySelectorAll('[data-alt-key]')) label.textContent = '⌥';
        });
      }

      // Header menus (the theme menu, the shortcuts map) are fluid shells driven from here, so
      // they work before any bundle loads and add none. A [data-shell] holds a
      // [data-shell-toggle], which a click opens and closes; [data-open] shows its panel. Nothing
      // opens on hover or on focus (Sean, 2026-10-15: the shortcuts map peeked on both).
      const toggleOf = (shell) => shell.querySelector('[data-shell-toggle]');
      // Counting (ADR 0019): a theme kept when its menu closes, however it closes, not the
      // previews the arrow keys step through.
      let themeAtOpen = null;
      const setOpen = (shell, open) => {
        const wasOpen = shell.hasAttribute('data-open');
        shell.toggleAttribute('data-open', open);
        toggleOf(shell)?.setAttribute('aria-expanded', String(open));
        if (wasOpen === open || !shell.querySelector('[data-theme-option]')) return;
        const theme = document.documentElement.dataset.theme;
        if (open) themeAtOpen = theme;
        else if (theme !== themeAtOpen) window.umami?.track('Theme picked', { theme });
      };
      const closeAll = (except) => {
        for (const shell of document.querySelectorAll('[data-shell]')) {
          if (shell !== except) setOpen(shell, false);
        }
      };
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const toggle = target?.closest('[data-shell-toggle]');
        if (toggle) {
          const shell = toggle.closest('[data-shell]');
          const open = !shell.hasAttribute('data-open');
          closeAll(shell);
          setOpen(shell, open);
          // Focus goes to the choice without moving the page; from the keyboard (a click with no
          // pointer, detail 0) it comes into view, as little as it takes, as the category menu's.
          const choice = open ? shell.querySelector('[data-shell-initial]:checked') : null;
          choice?.focus({ preventScroll: true });
          if (event.detail === 0) choice?.scrollIntoView({ block: 'nearest' });
          return;
        }
        if (!target?.closest('[data-shell]')) closeAll();
      });

      document.addEventListener('change', (event) => {
        const option = event.target;
        if (!(option instanceof HTMLInputElement) || !option.hasAttribute('data-theme-option'))
          return;
        if (!ids.includes(option.value)) return;
        apply(option.value);
        try {
          localStorage.setItem(key, option.value);
        } catch {
          // Storage blocked (private mode): the choice lasts for this page only.
        }
        // A click picks and closes. Arrow keys move through the radios and fire change on every
        // step, so a keyboard choice previews live and the menu stays open until Enter or Escape.
        const shell = option.closest('[data-shell]');
        if (shell && !option.matches(':focus-visible')) {
          setOpen(shell, false);
          toggleOf(shell)?.focus();
        }
      });
      // Focus leaving an open shell closes it, so a menu never stays drawn over the control that
      // now has focus (WCAG 2.4.11). A click on non-focusable content inside the shell moves focus
      // nowhere; while the mouse is over the shell that is not leaving it.
      document.addEventListener('focusout', (event) => {
        const shell =
          event.target instanceof Element ? event.target.closest('[data-shell][data-open]') : null;
        if (!shell) return;
        const next = event.relatedTarget;
        if (next instanceof Node ? shell.contains(next) : shell.matches(':hover')) return;
        setOpen(shell, false);
      });
      // Escape closes any open shell; focus returns to its toggle if it was inside.
      // An Escape that closed one does nothing else, so the converter's Escape from the page waits.
      document.addEventListener('keydown', (event) => {
        // ← and → on a theme option leave the menu, on the theme reached, and move along the
        // header's toolbar as from its trigger (Sean, 2026-10-15): ↑ and ↓ alone go through the
        // themes. The move is the toolbar's own, handed to it as a key on the trigger.
        const sideways = event.key === 'ArrowLeft' || event.key === 'ArrowRight';
        if (
          sideways &&
          event.target instanceof Element &&
          event.target.matches('[data-theme-option]')
        ) {
          const shell = event.target.closest('[data-shell][data-open]');
          const toggle = shell ? toggleOf(shell) : null;
          if (!toggle) return;
          event.preventDefault();
          setOpen(shell, false);
          toggle.focus();
          toggle.dispatchEvent(new KeyboardEvent('keydown', { key: event.key, bubbles: true }));
          return;
        }
        // Enter on a theme option keeps the previewed theme and closes the menu.
        if (event.key === 'Enter' && event.target instanceof Element) {
          const shell = event.target.matches('[data-theme-option]')
            ? event.target.closest('[data-shell][data-open]')
            : null;
          if (shell) {
            event.preventDefault();
            setOpen(shell, false);
            toggleOf(shell)?.focus();
          }
          return;
        }
        if (event.key !== 'Escape') return;
        for (const shell of document.querySelectorAll('[data-shell][data-open]')) {
          const focusWasInside = shell.contains(document.activeElement);
          setOpen(shell, false);
          if (focusWasInside) toggleOf(shell)?.focus();
          event.preventDefault();
        }
      });

      // Typing from anywhere, before the converter's code has loaded (docs/UX-SPEC.md §8): a key
      // that starts typing (a letter, a digit, `-`, `.`, or `,`) pressed with nothing focused moves
      // focus into the box, so the key lands in its field, which the island keeps as it loads.
      // Once loaded, the island does this itself.
      const startsTypingKey = new RegExp(startsTyping, startsTypingFlags);
      document.addEventListener('keydown', (event) => {
        if (document.querySelector('[data-hydrated]')) return;
        const active = document.activeElement;
        if (active && active !== document.body && active !== document.documentElement) return;
        if (event.ctrlKey || event.metaKey || event.altKey || event.isComposing) return;
        if (startsTypingKey.test(event.key))
          document.querySelector('[data-plane="box"] input')?.focus();
      });

      // Toolbars and planes (docs/UX-SPEC.md §8, ADR 0014). A [role=toolbar] is one Tab stop: ←
      // and → (Home, End) move along its [data-tool] controls in the order they show, round from
      // end to end, and the control last reached stays its stop (a roving tabindex; before that,
      // its [data-default-tool], or its first). ↑ and ↓ move between the page's [data-plane]s, top
      // to bottom, stopping at either end (Sean, 2026-10-15: going round jumped the length of the
      // page), landing on a toolbar's stop or a plane's first control; the
      // converter's box, a plane of its own, hands its ↑ and ↓ over once its rows run out (a
      // planeEvent from src/lib/planes.ts). Escape on a tool goes back to the box. Only a tool
      // itself answers, so a menu open inside a toolbar keeps its own keys.
      const shown = (element) => element.getClientRects().length > 0;
      const toolsOf = (bar) =>
        [...bar.querySelectorAll('[data-tool]')].filter(shown).sort((a, b) => {
          const [ra, rb] = [a.getBoundingClientRect(), b.getBoundingClientRect()];
          const sameLine = Math.abs(ra.top - rb.top) < Math.min(ra.height, rb.height) / 2;
          return sameLine ? ra.left - rb.left : ra.top - rb.top;
        });
      const stopOf = (bar) => {
        const tools = toolsOf(bar);
        return (
          tools.find((tool) => tool.getAttribute('tabindex') === '0') ??
          tools.find((tool) => tool.dataset.tool === bar.dataset.defaultTool) ??
          tools[0]
        );
      };
      const makeStop = (bar, stop) => {
        for (const tool of bar.querySelectorAll('[data-tool]')) {
          tool.setAttribute('tabindex', tool === stop ? '0' : '-1');
        }
      };
      // Each toolbar keeps exactly one stop, also once an island has drawn a tool into it (Copy URL).
      const settleToolbars = () => {
        for (const bar of document.querySelectorAll('[role="toolbar"]')) {
          const stop = stopOf(bar);
          if (stop) makeStop(bar, stop);
        }
      };
      document.addEventListener('DOMContentLoaded', settleToolbars);
      const planeEntry = (plane) =>
        plane.matches('[role="toolbar"]') ? stopOf(plane) : plane.querySelector('input, button');
      const movePlane = (from, step) => {
        const planes = [...document.querySelectorAll('[data-plane]')].filter(shown);
        const at = planes.findIndex((plane) => plane.contains(from));
        const next = at < 0 ? undefined : planes[at + step];
        if (next) planeEntry(next)?.focus();
      };
      document.addEventListener(planeEvent, (event) => movePlane(event.target, event.detail));
      document.addEventListener('focusin', (event) => {
        const tool = event.target instanceof Element ? event.target.closest('[data-tool]') : null;
        const bar = tool === event.target ? tool.closest('[role="toolbar"]') : null;
        if (!bar) return;
        makeStop(bar, tool);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Tab') settleToolbars();
        if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return;
        const tool = event.target instanceof Element ? event.target.closest('[data-tool]') : null;
        const bar = tool === event.target ? tool.closest('[role="toolbar"]') : null;
        if (!bar) return;
        if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
          event.preventDefault();
          movePlane(bar, event.key === 'ArrowDown' ? 1 : -1);
          return;
        }
        if (event.key === 'Escape') {
          const box = document.querySelector('[data-plane="box"]');
          if (!box) return;
          event.preventDefault();
          planeEntry(box)?.focus();
          return;
        }
        const tools = toolsOf(bar);
        const at = tools.indexOf(tool);
        const next = {
          ArrowRight: tools[(at + 1) % tools.length],
          ArrowLeft: tools[(at - 1 + tools.length) % tools.length],
          Home: tools[0],
          End: tools[tools.length - 1],
        }[event.key];
        if (!next) return;
        event.preventDefault();
        next.focus();
      });
    </script>
  </head>
  {/* A column at least the window's height, so the footer (SiteFooter) sits at the window's
      bottom on a page shorter than it; each page's column fills its width (PAGE_COLUMN). */}
  <body class="flex min-h-dvh flex-col bg-canvas font-body text-ink antialiased">
    <slot />
    <SiteFooter class="mt-auto" />
  </body>
</html>
