---
import PageHeader from '../components/PageHeader.astro';
import Base from './Base.astro';
import { PAGE_MAIN } from '../lib/recipes';

interface Props {
  /** The page's name, after the site's in the title: "gallery". */
  title: string;
  description: string;
  /** The wordmark waits for the page to play it (the wordmark lab). */
  manual?: boolean;
  /** Show the keyboard shortcuts map in the header (the gallery's sample of it). */
  shortcuts?: boolean;
}

const { title, description, manual = false, shortcuts = false } = Astro.props;

/*
 * A development page under /dev: the site's header, a line saying what the page is for 24 px
 * under it (as the converter's intro sits), then its tools a section step down (docs/DESIGN-SYSTEM.md,
 * "Sections step by the frame"). Nothing on the site links here, and search engines are asked not to index it, so the
 * live site keeps it for the owner without showing it to visitors (docs/ARCHITECTURE.md).
 */
---

<Base title={`bigsmall · ${title}`} description={description} noindex>
  <main class={PAGE_MAIN}>
    <PageHeader manual={manual} shortcuts={shortcuts} />
    <p class="mt-6 max-w-prose text-sm text-ink-muted">
      <slot name="intro" />
    </p>
    <slot />
  </main>
</Base>
