---
import PageHeader from '../components/PageHeader.astro';
import { Tabs } from '../components/Tabs';
import { Feedback } from '../features/feedback/Feedback';
import Formulas from '../features/formulas/Formulas.astro';
import SketchSprite from '../features/sketchbook/SketchSprite.astro';
import { Sketchbook } from '../features/sketchbook/Sketchbook';
import Base from '../layouts/Base.astro';
import { CONTENT_COLUMN, cx, PAGE_MAIN, SECTION_HEADING } from '../lib/recipes';
import { SITE } from '../lib/site';

/*
 * The About page (docs/UX-SPEC.md §1), reached from the footer: the sketchbook, centered under its
 * heading (Sean, 2026-10-15 and 16), the logo sketches at play as tuned in /dev/sketchbook-lab;
 * then, in the page's column (CONTENT_COLUMN, centered as on every page, the header on it too), two tabs on the column's left
 * edge, Feedback and Every formula, the tab the title (Sean, 2026-10-18; kept), Feedback open
 * first: the form that posts to the form service (ADR 0024), and every formula the converter uses
 * with its source (Sean, 2026-10-16). A link to #feedback or #formulas opens its tab. The privacy
 * line is the footer's (SiteFooter).
 */
const TABS = [
  { id: 'feedback', label: 'Feedback' },
  { id: 'formulas', label: 'Every formula' },
] as const;
---

<Base
  title={`About · ${SITE.name}`}
  description="The bigsmall sketchbook and every formula and reference behind each calculation."
>
  <main class={PAGE_MAIN}>
    <PageHeader class={CONTENT_COLUMN} />
    <section class="mt-12 sm:mt-20" aria-labelledby="sketchbook">
      <h2 id="sketchbook" class:list={[SECTION_HEADING, 'mb-6 text-center']}>
        The sketchbook
      </h2>
      <SketchSprite />
      <Sketchbook client:load />
    </section>
    <div class={cx(CONTENT_COLUMN, 'mt-16 sm:mt-24')}>
      <Tabs client:load label="About" tabs={TABS}>
        <div slot="feedback" class="max-w-md">
          <Feedback client:visible />
        </div>
        <Fragment slot="formulas">
          <Formulas />
        </Fragment>
      </Tabs>
    </div>
  </main>
</Base>
