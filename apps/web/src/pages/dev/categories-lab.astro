---
import DevPage from '../../layouts/DevPage.astro';
import { CategoriesLab } from './_categories-lab/CategoriesLab';

/*
 * Categories bigsmall does not have yet, mocked for how they read and lay out
 * (docs/research/categories-1.md): pace, a temperature change, and cooking by ingredient, drawn
 * with the real box, table, and menus in frozen states, wide or at a phone's width. Nothing
 * converts here; the values are worked out by hand. It retires once the categories ship
 * (CLAUDE.md, "Retire a lab").
 */
---

<DevPage
  title="categories lab"
  description="How pace, a temperature change, and cooking by ingredient would read in the box and the table."
>
  <Fragment slot="intro">
    Categories lab. Three categories bigsmall doesn't have yet, mocked with the real box and table:
    nothing converts here, and the values are worked out by hand. Switch the width to see them at a
    phone's; the theme menu shows them in every theme.
  </Fragment>
  <CategoriesLab client:load />
</DevPage>
