---
import DevPage from '../../layouts/DevPage.astro';
import { OrganizationLab } from './_organization-lab/OrganizationLab';

/*
 * The settings lab (Sean, 2026-10-10; docs/research/organization-lab.md): the Settings button in
 * the action bar, what shows and how it looks, the table's sections and its Hidden list, and
 * search with hidden units, with single units chosen in the table and Settings' choices drawn as
 * segmented controls.
 */
---

<DevPage
  title="settings lab"
  description="The Settings button, the table's sections, and hidden units."
>
  <Fragment slot="intro">
    Settings lab. The action bar leads with the category menu, the calculator, and Settings: what
    shows, in every category, and how results look. Edit at the table's foot chooses single units;
    hidden ones wait in a Hidden list under their section names. Type a unit's name in the box to
    see how search treats hidden ones.
  </Fragment>
  <OrganizationLab client:load />
</DevPage>
