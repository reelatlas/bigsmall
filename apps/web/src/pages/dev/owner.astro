---
import DevPage from '../../layouts/DevPage.astro';
import { OwnVisits } from './_owner/OwnVisits';

/*
 * The owner's page (docs/DEPLOYMENT.md, "Our own visits"): one switch that leaves this browser's
 * visits out of Umami's counts, for each browser Sean uses and his phone, where a console is out
 * of reach. Nothing links here and search engines are asked not to index it, like every /dev page.
 */
---

<DevPage
  title="owner"
  description="Leave this browser’s visits out of the site’s counts, or count them again."
>
  <Fragment slot="intro">
    Owner’s page. Umami counts visits to bigsmall.work; press the button to leave this browser’s
    out, once in each browser you use and once on your phone. The setting lives in this browser (its
    storage, under <code class="font-numeric">umami.disabled</code>) and holds until the site’s data
    is cleared; nothing is sent anywhere.
  </Fragment>
  <OwnVisits client:load />
</DevPage>
