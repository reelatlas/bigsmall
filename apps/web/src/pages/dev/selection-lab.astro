---
import DevPage from '../../layouts/DevPage.astro';
import { SelectionLab } from './_selection-lab/SelectionLab';

/*
 * Prototypes for choosing a category and a unit in the table layout without a list drawn over the
 * table (Sean, 2026-10-07). Each is built from the real engine, table, chip, and field, but holds
 * its own simple state: no undo, no URL. Sean picked A, the category menu, now built into the
 * converter (ADR 0012); the lab keeps all three for comparison.
 */
---

<DevPage title="selection lab" description="Prototypes for choosing a category and a unit.">
  <Fragment slot="intro">
    Selection lab. Three ways to choose a category and a unit with the table always in view; A, the
    category menu, is now the converter's table layout. Each starts empty, the way a first visit
    does; Start over resets it.
  </Fragment>
  <SelectionLab client:load />
</DevPage>
