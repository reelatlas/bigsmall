---
import DevPage from '../../layouts/DevPage.astro';
import { TableControlsLab } from './_table-controls-lab/TableControlsLab';

/*
 * Prototypes for filtering the table and naming its sections (Sean, 2026-10-08;
 * docs/research/table-controls.md). Built from the real engine, table view, category menu, and
 * chip, with the table's columns and its names giving way, but holding its own simple state.
 */
---

<DevPage
  title="table controls lab"
  description="Prototypes for filtering the table and naming its sections."
>
  <Fragment slot="intro">
    Table controls lab. Four ways to filter the table's units, and four ways to mark its sections,
    in any pairing, for a US, UK, or metric visitor at a phone's width or a wide one. Pick a
    category from the menu, type a number, and click a row to move its unit into the box.
  </Fragment>
  <TableControlsLab client:load />
</DevPage>
