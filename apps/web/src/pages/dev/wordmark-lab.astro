---
import DevPage from '../../layouts/DevPage.astro';
import { WordmarkLab } from './_wordmark-lab/WordmarkLab';

/*
 * The wordmark at play with every setting on a slider (docs/DESIGN-SYSTEM.md, "Tuning labs"). The
 * header is the real one, in the page theme; settings apply live, persist in this browser, and
 * "Copy settings" gives the values to paste into lib/timing.ts and lib/wordmark.ts, where they
 * become the defaults.
 */
---

<DevPage title="wordmark lab" description="Tune the wordmark at play." manual>
  <Fragment slot="intro">
    Wordmark lab. Hover the name and its art to play it with the settings below, or play it without
    hovering. The theme menu switches the page theme, and the sheet of phrases at the bottom refits
    to it.
  </Fragment>
  <WordmarkLab client:load />
</DevPage>
