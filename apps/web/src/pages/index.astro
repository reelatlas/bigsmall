---
import ThemePicker from '../components/ThemePicker.astro';
import { ConverterPreview } from '../features/converter/ConverterPreview';
import Base from '../layouts/Base.astro';
---

<Base title="bigsmall">
  <main class="mx-auto max-w-2xl px-4 py-10">
    <header class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="font-display text-3xl font-semibold tracking-tight">bigsmall</h1>
      <ThemePicker />
    </header>
    <p class="mt-3 text-ink-muted">
      Type anything into either box and get the answer. The converter itself lands in milestone 2;
      this page proves the engine, the themes, and the build.
    </p>
    <ConverterPreview client:load />
    <p class="mt-8 text-sm">
      <a href="/dev/gallery" class="underline underline-offset-4">
        Component gallery
      </a>
    </p>
  </main>
</Base>
