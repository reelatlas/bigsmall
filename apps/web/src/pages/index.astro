---
import PageHeader from '../components/PageHeader.astro';
import { Converter } from '../features/converter/Converter';
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import { COLUMN_CELL, CONTENT_COLUMN, CONVERTER_MAIN, cx } from '../lib/recipes';
---

<Base title={SITE.title}>
  <main class={CONVERTER_MAIN}>
    <PageHeader class={cx(CONTENT_COLUMN, COLUMN_CELL)} actions shortcuts />
    <Converter client:load />
  </main>
</Base>
