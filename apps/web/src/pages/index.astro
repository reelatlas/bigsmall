---
import HeaderMenus from '../components/HeaderMenus.astro';
import Wordmark from '../components/Wordmark.astro';
import { Converter } from '../features/converter/Converter';
import Base from '../layouts/Base.astro';
---

<Base title="bigsmall">
  <main class="mx-auto max-w-4xl px-4 py-8 sm:py-12">
    <header class="@container flex flex-wrap items-center justify-between gap-x-4 gap-y-5">
      <Wordmark />
      <HeaderMenus actions />
    </header>
    <Converter client:load />
    <p class="mt-10 text-sm">
      <a href="/dev/gallery" class="underline underline-offset-4">
        Component gallery
      </a>
    </p>
  </main>
</Base>
